<% layout("/layouts/boilerplate") %>

<section class="listings-toolbar">
    <div>
        <p class="eyebrow">Stay Catalog</p>
        <h1>All Listings</h1>
        <p><%= allListings.length %> stays available across cities, mountains, beaches, and retreats.</p>
    </div>
    <a href="/listings/new" class="btn btn-primary brand-btn">
        <i class="fa-solid fa-plus"></i>
        Add listing
    </a>
</section>

<div class="listing-grid listing-grid--catalog">
    <% for(let listing of allListings) { %>
        <a href="/listings/<%= listing._id %>" class="listing-card">
            <div class="listing-card__media">
                <img src="<%= listing.image %>" alt="<%= listing.title %>">
            </div>
            <div class="listing-card__body">
                <div>
                    <h3><%= listing.title %></h3>
                    <p><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p>
                </div>
                <strong>&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %><span>/night</span></strong>
            </div>
        </a>
    <% } %>
</div>
